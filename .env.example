# Copy to .env.local for local development. Never commit secrets.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Supabase ---
# From `supabase start` output (local) or Supabase dashboard (prod).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for MikroORM.
# Local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Prod:   use Supabase "Session mode" pooler URI (NOT transaction mode)
DATABASE_URL=

# --- Inngest ---
# Leave empty locally; the Inngest dev server handles signing.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Stripe (example; the invoice workflow uses this) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
